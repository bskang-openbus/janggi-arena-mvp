{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "description": "Janggi Arena online match server - NestJS + socket.io, server-authoritative rule validation.",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter engine build && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "pnpm run build && node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter engine build && tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/websockets": "11.1.28",
    "engine": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "socket.io-client": "4.8.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
