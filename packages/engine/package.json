{
  "name": "engine",
  "version": "0.0.1",
  "private": true,
  "description": "Janggi (Korean chess) rule engine - pure TypeScript, zero runtime dependencies.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "perft": "node --import ./scripts/ts-resolve.mjs scripts/perft.ts",
    "fixtures": "node --import ./scripts/ts-resolve.mjs scripts/generate-fixtures.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
